{
  "name": "pso",
  "private": true,
  "version": "0.1.0",
  "description": "P.S.O. — Pet Strike Online",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "balance": "tsx scripts/balance-sim.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
